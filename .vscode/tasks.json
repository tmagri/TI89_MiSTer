      "command": "bash",
      "args": [
        "${workspaceFolder}/ti89_build_debug.sh",
        "--kill"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TI-89: Show script help",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/ti89_build_debug.sh",
        "--help"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
